# Copy to .env and change every value marked CHANGE-ME before running docker compose.

# --- MySQL ---
MYSQL_DATABASE=recycling
MYSQL_USER=recycling
MYSQL_PASSWORD=CHANGE-ME-db-password
MYSQL_ROOT_PASSWORD=CHANGE-ME-root-password

# --- Django ---
DJANGO_SECRET_KEY=CHANGE-ME-long-random-string
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,backend
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000
TIME_ZONE=Australia/Sydney

# --- Ports on the host ---
FRONTEND_PORT=3000
BACKEND_PORT=8000

# --- Provider callback (ICollectionStatus): provider sends this in X-Provider-Key ---
PROVIDER_API_KEY=CHANGE-ME-provider-key
# Provider contact details included in every confirmation (placeholders - set the real ones)
PROVIDER_NAME=Cleanaway Waste Management
PROVIDER_PHONE=1300 000 000
PROVIDER_EMAIL=recycling@provider.example
PROVIDER_WEBSITE=

# --- Output API: comma-separated keys other services send in X-API-Key ---
INTEGRATION_API_KEYS=CHANGE-ME-integration-key

# --- Optional: push every booking status change to another service ---
OUTPUT_WEBHOOK_URL=
OUTPUT_WEBHOOK_SECRET=

# --- E-mail (console backend prints notifications to the backend logs) ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=true

# --- Demo accounts created on first start (leave blank to skip) ---
# Resident login: resident / DEMO_RESIDENT_PASSWORD
# Staff login (provider console + /admin): provider_admin / DEMO_STAFF_PASSWORD
DEMO_RESIDENT_PASSWORD=
DEMO_STAFF_PASSWORD=
